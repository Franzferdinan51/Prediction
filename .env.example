# Browser-to-local orchestration API. Keep this localhost-only for local use.
VITE_SIGNAL_API_URL=http://127.0.0.1:8787

# Optional server-side auth when the API is exposed beyond localhost.
SIGNAL_API_TOKEN=

# Search providers. SearXNG is the default and can be self-hosted with no key.
SEARXNG_URL=http://127.0.0.1:8080
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional OpenAI OAuth callback URL for a separate server implementation.
VITE_OPENAI_OAUTH_URL=
